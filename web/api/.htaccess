# Apache: 只允许走 index.php 入口，禁止下载源码与配置
<FilesMatch "^(InstantMail|config|cache|auth)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

DirectoryIndex index.php

# 部分 CGI/FastCGI 不透传 Authorization 头，导致外部 API 鉴权恒 401
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

  # 保证 POST JSON 能传到 PHP
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
